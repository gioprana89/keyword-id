list.files()
library(rvest)
url <- "metrotv_1.html"
# Read the HTML content from the URL
html1 <- read_html(url)
html1
data1 <- html1 %>%
html_nodes("div._a9zm") %>% html_nodes("div.xt0psk2")  %>%
html_text2()
data1[1]
data1[2]
#data1[642] #pada kasus ini memuat komentar kosong ""
#data1[957] #pada kasus ini memuat komentar kosong ""
length(data1)
data11 <- data1
Xbaru_tanpa_data_kosong = 0
data1_tanpa_data_kosong = 0
X <- data1
length(X)
catat_indeks = 0
k = 0
for(i in 1 : length(X)  )
{
if(X[i] == "")
{
k = k + 1
catat_indeks[k] = i
}
}
catat_indeks
if( k == 0  )
{
data1_tanpa_data_kosong = data1
}
if( k > 0  )
{
Xbaru_tanpa_data_kosong = X[-c(catat_indeks)]
data1_tanpa_data_kosong = Xbaru_tanpa_data_kosong
}
length(data1_tanpa_data_kosong)
data1_tanpa_data_kosong[1]
data1_tanpa_data_kosong[2]
#data1_tanpa_data_kosong[642]
#data1_tanpa_data_kosong[957]
data1 <- html1 %>%
html_nodes("div._a9zm") %>%
html_text2()
#data1
length(data1)
ambil_akun = 0
deteksi_gambar = 0
catat_indeks_untuk_akun_kosong_dan_gambar = 0
k = 0
library(stringr)
for(i in 1 : length(data1))
{
X = str_split(data1[i], fixed("\n"))
ambil_akun[i] <-  X[[1]][1]
deteksi_gambar[i] <- length(X[[1]])
if(deteksi_gambar[i] == 3)
{
k = k + 1
catat_indeks_untuk_akun_kosong_dan_gambar[k] = i
}
}
#ambil_akun
print("\n\n\n")
#deteksi_gambar
length(deteksi_gambar)
table(deteksi_gambar)
print(catat_indeks_untuk_akun_kosong_dan_gambar)
ambil_akun_baru = 0
if(  sum(catat_indeks_untuk_akun_kosong_dan_gambar) > 0 )
{
ambil_akun_baru = ambil_akun[-c(catat_indeks_untuk_akun_kosong_dan_gambar)]
}
length(ambil_akun_baru)
dframe = 0
if(  sum(catat_indeks_untuk_akun_kosong_dan_gambar) > 0 )
{
dframe = data.frame(ambil_akun_baru, data1_tanpa_data_kosong)
}
if(  sum(catat_indeks_untuk_akun_kosong_dan_gambar) == 0 )
{
dframe = data.frame(ambil_akun, data11)
}
dframe9 = dframe
jumlah_data <- length(  dframe9[,1]  )
nama_akun <- rep("metrotv", jumlah_data  )
link_akun <- rep("https://www.instagram.com/metrotv/reel/DMulN9htk6M/", jumlah_data  )
dframe9_fix <- data.frame(dframe9, nama_akun, link_akun)
colnames(dframe9_fix) <- c("Akun", "Percakapan", "Asal Akun", "Link Akun")
jumlah_data = length(dframe9_fix[,1])
dframe9_fix[c(jumlah_data),]
dframe9_fix[c(1),]
