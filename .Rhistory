Akun <- dframe_total[,1]
Jumlah_Akun <- table(Akun)
nama_akun <- names(Jumlah_Akun)
nama_akun <- unlist(nama_akun)
nama_akun <- as.character(nama_akun)
names(Jumlah_Akun) = NULL
Jumlah_Akun <- unlist(Jumlah_Akun)
Jumlah_Akun <- as.numeric(Jumlah_Akun)
dframe <- data.frame(nama_akun, Jumlah_Akun)
dframe_akun <- dframe[order(-dframe$Jumlah_Akun), ]
colnames(dframe_akun) = c("Akun", "Jumlah Postingan")
dframe_akun
wb <- openxlsx::createWorkbook()
hs1 <- openxlsx::createStyle(fgFill = "#DCE6F1", halign = "CENTER", textDecoration = "italic",
border = "Bottom")
hs2 <- openxlsx::createStyle(fontColour = "#ffffff", fgFill = "#4F80BD",
halign = "center", valign = "center", textDecoration = "bold",
border = "TopBottomLeftRight")
openxlsx::addWorksheet(wb, "Data Akun", gridLines = TRUE)
openxlsx::writeDataTable(wb, "Data Akun", dframe_akun, rowNames = FALSE, startRow = 2, startCol = 2, tableStyle = "TableStyleMedium21")
openxlsx::openXL(wb)
