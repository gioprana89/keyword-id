library(readxl)
X <- list.files()
length(X)
X
data_paper = 0
link_scopus <- vector(mode = "character")
k = 0
for(i in 1 :  (     length(X) - 2    ) )
{
a <- read_xlsx(X[i])
a <- as.data.frame(a)
a <- a[1,"Link Scopus"]
a <- unlist(a)
link_scopus[i] = a
}
print(link_scopus)
jumlah_Jurnal_scopus <- na.omit(link_scopus)
jumlah_Jurnal_scopus <- unlist(jumlah_Jurnal_scopus)
length(jumlah_Jurnal_scopus)
data_paper = 0
link_Sinta <- vector(mode = "character")
for(i in 1 :  (     length(X) - 2    ) )
{
a <- read_xlsx(X[i])
a <- as.data.frame(a)
a <- a[1,"Link SINTA"]
a <- unlist(a)
link_Sinta[i] = a
}
print(link_Sinta)
jumlah_Jurnal_Sinta <- na.omit(link_Sinta)
jumlah_Jurnal_Sinta <- unlist(jumlah_Jurnal_Sinta)
length(jumlah_Jurnal_Sinta)
data_paper = 0
ambil_issn = vector(mode = "character")
ambil_nomor = vector(mode = "character")
for(i in 1 :  length(X) - 2 )
{
if(i == 1)
{
a <- read_xlsx(X[i])
a <- as.data.frame(a)
data_paper <- a
x <- a[,"ISSN"]
x <- unlist(x)
x <- as.character(x)
ambil_issn <- x
x <- a[,"No"]
x <- unlist(x)
x <- as.character(x)
ambil_nomor <- x
}
if(i > 1)
{
a <- read_xlsx(X[i])
a <- as.data.frame(a)
data_paper <- rbind(data_paper, a)
x <- a[,"ISSN"]
x <- unlist(x)
x <- as.character(x)
ambil_issn <- c(ambil_issn, x)
x <- a[,"No"]
x <- unlist(x)
x <- as.character(x)
ambil_nomor <- c(ambil_nomor, x)
}
}
data_paper[,1] = c(1 :  length(data_paper[,1])   )
#data_paper
unique_number <- paste0(ambil_issn, "-",ambil_nomor)
unique_number <- as.data.frame(unique_number)
data_paper <- data.frame(data_paper, unique_number)
nama_kolom <- c("No",
"Judul Artikel",
"Author",
"Jumlah Author",
"Tahun",
"Volume",
"Issue",
"Page",
"Nama Jurnal",
"Keyword",
"ISSN",
"Abstrak",
"Link Artikel",
"Link SINTA",
"Link Scopus",
"Scope",
"Sudah Download",
"Tanggal Input Data",
"Unique ID")
colnames(data_paper) = nama_kolom
data_paper
wb <- openxlsx::createWorkbook()
hs1 <- openxlsx::createStyle(fgFill = "#DCE6F1", halign = "CENTER", textDecoration = "italic",
border = "Bottom")
hs2 <- openxlsx::createStyle(fontColour = "#ffffff", fgFill = "#4F80BD",
halign = "center", valign = "center", textDecoration = "bold",
border = "TopBottomLeftRight")
openxlsx::addWorksheet(wb, "Data Paper", gridLines = TRUE)
openxlsx::writeDataTable(wb, "Data Paper", data_paper, rowNames = FALSE, startRow = 2, startCol = 2, tableStyle = "TableStyleMedium21")
openxlsx::openXL(wb)
