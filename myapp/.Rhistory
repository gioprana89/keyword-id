library(readxl)
data_judol <- read_xlsx("judol.xlsx")
data_judol <- as.data.frame(data_judol)
data_judol
data_judol2 <- data_judol[c("Keyword")]
data_judol3 <- data_judol2
for(i in 1 : length(data_judol2[,1]))
{
x <- data_judol2[i,1]
simpan_keyword_hapus_spasi <- gsub(" ", "", x)
simpan_keyword_hapus_spasi <- gsub("-", "", simpan_keyword_hapus_spasi)
simpan_keyword_hapus_spasi <- gsub("'", "", simpan_keyword_hapus_spasi)
data_judol3[i,1] = simpan_keyword_hapus_spasi
}
data_judol3
library(tidytext)
nasa_judol <- data_frame(id = c(1 :  length(data_judol3[,1])  ),
keyword = data_judol3$Keyword ) %>% unnest(keyword)
