library(ggraph)
library(tidyr)
library(dplyr)
library(tidytext)
library(widyr)
library(tidyr)
library(widyr)
nasa_judol <- data_frame(id = c(1 :  length(data_judol3[,1])  ),
keyword = data_judol3$Keyword ) %>% unnest(keyword)
nasa_judol <-  nasa_judol %>%  unnest_tokens(word, keyword) %>%  anti_join(stop_words)
nasa_judol
library(widyr)
title_word_pairs <- nasa_judol %>%
pairwise_count(word, id, sort = TRUE, upper = FALSE)
title_word_pairs
library(ggplot2)
library(igraph)
library(ggraph)
set.seed(1234)
title_word_pairs %>%
filter(n >= 3) %>%
graph_from_data_frame() %>%
ggraph(layout = "fr") +
geom_edge_link(aes(edge_alpha = n, edge_width = n), edge_colour = "cyan4") +
geom_node_point(size = 5) +
geom_node_text(aes(label = name), repel = TRUE,
point.padding = unit(0.2, "lines")) +
theme_void()
